# ============ Execution mode ============
# true  = agent trades on Binance TESTNET (free, fake funds)
# false = mainnet (requires Agentic sub-account keys) — keep false for the demo
BINANCE_TESTNET=true

# API keys — when BINANCE_TESTNET=true, use TESTNET keys from
# https://testnet.binance.vision (login -> API keys). Leave empty to run
# in paper mode (no orders placed at all).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional overrides:
# BINANCE_DRY_RUN=false   # force paper mode even without --testnet
# BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# ============ Sentiment LLM (all optional — VADER works offline) ============
# Google AI Studio free key (gemini-flash-lite-latest)
GOOGLE_API_KEY=
# Groq free key (llama-3.1-8b-instant fallback)
GROQ_API_KEY=
# CryptoPanic free key (hot news source)
CRYPTOPANIC_API_KEY=

# ============ Risk guardrails ============
MAX_NOTIONAL_PER_TRADE=100
MAX_SLIPPAGE_BPS=50
MAX_DAILY_LOSS_PCT=3.0
POSITION_PCT_PER_TRADE=2.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
SENTIMENT_THRESHOLD_BUY=70
SENTIMENT_THRESHOLD_SELL=30
