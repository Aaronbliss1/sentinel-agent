# ============ Binance Agent OS (agentic sub-account) ============
# Leave keys empty to run fully in paper mode (no live data/trading needed).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = paper trading (default, SAFE for the hackathon demo)
# false = live trading on the Agentic sub-account
BINANCE_DRY_RUN=true

# Optional: use Binance testnet instead of production
BINANCE_TESTNET=false

# Official Agent OS MCP endpoint (Streamable HTTP)
BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# ============ Sentiment LLM (all optional — VADER works offline) ============
# Google AI Studio free key (gemini-flash-lite-latest)
GOOGLE_API_KEY=
# Groq free key (llama-3.1-8b-instant fallback)
GROQ_API_KEY=
# CryptoPanic free key (hot news source)
CRYPTOPANIC_API_KEY=

# ============ Risk guardrails ============
MAX_NOTIONAL_PER_TRADE=100
MAX_SLIPPAGE_BPS=50
MAX_DAILY_LOSS_PCT=3.0
POSITION_PCT_PER_TRADE=2.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
SENTIMENT_THRESHOLD_BUY=70
SENTIMENT_THRESHOLD_SELL=30
